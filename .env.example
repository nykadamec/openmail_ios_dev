IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
ICLOUD_USER=your_icloud@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=dominik@adamec.pro
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Cloudflare Access (Zero Trust) - optional extra auth layer
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_AUD_TAG=your-application-audience-tag

# Encryption key for stored emails (32 bytes base64). Generate with: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
